# Copy to .env for local development. Never commit the real .env file.

# --- Client-side (exposed to the browser via Vite's VITE_ prefix) ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Server-side only (never prefix with VITE_, never expose to the client) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Service-role key: bypasses RLS. Required for admin operations, order
# management, storage uploads, etc. Get from Supabase Dashboard ->
# Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# Random 32+ byte secret used to sign admin session JWT cookies.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="..."
